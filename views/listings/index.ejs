<% layout('/layouts/boilerplate') -%>
<% const q = query || {}; %>
  <div class="listings-header d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
      <h3 class="mb-1">Explore stays</h3>
      <p class="text-muted mb-0 small">
        <%= allListings.length %> listing<%= allListings.length === 1 ? "" : "s" %>
        <% if (q.location || q.country || q.minPrice || q.maxPrice) { %> matching your search<% } %>
      </p>
    </div>
    <% if (q.location || q.country || q.minPrice || q.maxPrice || includeTaxes) { %>
      <a href="/listings" class="btn btn-link btn-sm text-decoration-none">Clear filters</a>
    <% } %>
  </div>

  <section class="filter-panel mb-4 rounded-4 shadow-sm p-4">
    <form action="/listings" method="GET" class="row g-3 align-items-end">
      <div class="col-lg-4 col-md-6">
        <label for="searchLocation" class="form-label text-uppercase fw-semibold small text-muted">Where</label>
        <input id="searchLocation" name="location" type="text" class="form-control"
          placeholder="City, region, or title" value="<%= q.location || '' %>">
      </div>
      <div class="col-lg-3 col-md-6">
        <label class="form-label text-uppercase fw-semibold small text-muted">Price</label>
        <div class="input-group">
          <span class="input-group-text">₹</span>
          <input name="minPrice" type="number" class="form-control" placeholder="Min" min="0"
            value="<%= q.minPrice || '' %>">
          <span class="input-group-text">to</span>
          <input name="maxPrice" type="number" class="form-control" placeholder="Max" min="0"
            value="<%= q.maxPrice || '' %>">
        </div>
      </div>
      <div class="col-lg-3 col-md-6">
        <label for="searchCountry" class="form-label text-uppercase fw-semibold small text-muted">Country</label>
        <input id="searchCountry" name="country" type="text" class="form-control" placeholder="e.g. Italy"
          value="<%= q.country || '' %>">
      </div>
      <div class="col-lg-2 col-md-6 d-grid">
        <button type="submit" class="btn btn-dark btn-lg">Search</button>
      </div>

      <div class="col-12">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="taxSwitch" name="includeTaxes"
            <%= includeTaxes ? 'checked' : '' %>>
          <label class="form-check-label" for="taxSwitch">Show prices with 18% tax</label>
        </div>
      </div>
    </form>
  </section>

  <% if (!allListings.length) { %>
    <div class="empty-listings text-center py-5">
      <p class="text-muted mb-3">No listings match your filters.</p>
      <a href="/listings" class="btn btn-outline-dark">View all listings</a>
    </div>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 listings-grid">
      <% for (let listing of allListings) { %>
        <% const displayPrice = includeTaxes ? Math.round(listing.price * 1.18) : listing.price; %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark d-block h-100 listing-link">
            <div class="card listing-card h-100">
              <% if (listing.image?.url || listing.image) { %>
                <img src="<%= listing.image?.url || listing.image %>" class="card-img-top" alt="<%= listing.title %>"
                  loading="lazy">
              <% } %>
              <div class="card-body">
                <p class="card-text mb-1">
                  <b><%= listing.title %></b>
                </p>
                <p class="card-text text-muted small mb-1">
                  <%= listing.location %>, <%= listing.country %>
                </p>
                <p class="card-text mb-0">
                  &#8377; <%= displayPrice.toLocaleString("en-IN") %>/night
                  <% if (includeTaxes) { %><span class="text-muted small">(incl. tax)</span><% } %>
                </p>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>
