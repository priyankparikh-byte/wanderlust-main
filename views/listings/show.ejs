<% layout('/layouts/boilerplate') -%>
<div class="row mt-4">
  <div class="col-lg-8 mx-auto col-md-10 col-12">
    <h2 class="show-title"><%= listing.title %></h2>
    
    <div class="show-card-img-container">
      <% if (listing.image?.url || listing.image) { %>
        <img src="<%= listing.image?.url || listing.image %>" class="show-img" alt="<%= listing.title %>">
      <% } %>
    </div>

    <div class="show-details">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
          <h4 class="host-name mb-1">Hosted by <%= listing.owner.username %></h4>
          <p class="location-box mb-0">
            <i class="fa-solid fa-location-dot me-1"></i>
            <%= listing.location %>, <%= listing.country %>
          </p>
        </div>
        <div class="price-box text-md-end mb-0">
          &#8377; <%= listing.price.toLocaleString("en-IN") %> <span>/ night</span>
        </div>
      </div>
      
      <h5 class="fw-bold mb-2">About this place</h5>
      <p class="description-text mb-0"><%= listing.description %></p>
    </div>

    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
      <div class="btns gap-3 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary-action px-4">Edit Listing</a>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="d-inline">
          <button class="btn btn-secondary-action px-4">Delete Listing</button>
        </form>
      </div>
    <% } %>

    <!-- Map Section -->
    <div class="mb-5">
      <h4 class="map-title"><i class="fa-regular fa-map me-2"></i>Where you'll stay</h4>
      <div id="listingMap" class="listing-map" data-location="<%= listing.location %>" data-country="<%= listing.country %>" aria-label="Map of <%= listing.location %>, <%= listing.country %>"></div>
    </div>

    <!-- Reviews Section -->
    <div class="reviews-section py-4">
      <% if(currentUser) { %>
        <div class="card p-4 border rounded-4 shadow-sm mb-5">
          <h4 class="fw-bold mb-3"><i class="fa-regular fa-comment-dots me-2"></i>Leave a Review</h4>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
              <label class="form-label d-block">Rating</label>
              <fieldset class="starability-basic starability-fade">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                <label for="second-rate1" title="Terrible">1 star</label>
                <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                <label for="second-rate2" title="Not good">2 stars</label>
                <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                <label for="second-rate3" title="Average">3 stars</label>
                <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                <label for="second-rate4" title="Very good">4 stars</label>
                <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                <label for="second-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            
            <div class="mb-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea id="comment" name="review[comment]" cols="30" rows="4" class="form-control" placeholder="Tell us about your experience..." required></textarea>
              <div class="invalid-feedback">Please write a review comment.</div>
            </div>
            
            <button class="btn btn-primary-action px-4">Submit Review</button>
          </form>
        </div>
      <% } %>

      <% if(listing.reviews && listing.reviews.length > 0) { %>
        <h4 class="fw-bold mb-4"><i class="fa-regular fa-comments me-2"></i>All Reviews (<%= listing.reviews.length %>)</h4>
        <div class="row g-3">
          <% for(review of listing.reviews) { %>
            <div class="col-md-6">
              <div class="review-card">
                <div>
                  <h5 class="review-author mb-1"><%= review.author ? review.author.username : "Anonymous" %></h5>
                  <p class="starability-result" data-rating="<%= review.rating %>"></p>
                  <p class="review-comment mb-3"><%= review.comment %></p>
                </div>
                <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                  <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mt-auto">
                    <button class="btn btn-sm btn-outline-danger px-3 rounded-pill">Delete Review</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
