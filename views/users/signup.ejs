<% layout('/layouts/boilerplate') -%>

<div class="row mt-4 mb-5">
    <div class="col-lg-6 mx-auto col-md-8 col-12">
        <div class="form-card">
            <h3><i class="fa-solid fa-user-plus me-2 text-danger"></i>Sign Up</h3>
            
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input name="email" placeholder="Enter your email address" type="email" class="form-control" required />
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>
                
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" placeholder="Choose a username" type="text" class="form-control" required />
                    <div class="invalid-feedback">Please choose a username.</div>
                </div>
                
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" placeholder="Create a strong password" type="password" class="form-control" required />
                    <div class="invalid-feedback">Please create a password.</div>
                </div>
                
                <button type="submit" class="btn btn-primary-action px-5 w-100">Sign Up</button>
            </form>
            
            <div class="text-center mt-3">
                <span class="text-muted small">Already have an account? <a href="/login" class="text-danger fw-bold text-decoration-none">Login</a></span>
            </div>
        </div>
    </div>
</div>
